# Copy to .env and rebuild (npm run build). Leave a value empty to disable it.
# Public address of the site (used for canonical URLs, sitemap and Open Graph)
SITE_ORIGIN=https://timur-alt2008.github.io
# Path the site is served from. "/" for a custom domain.
BASE_PATH=/HYDRA-Digital-Studio/

# Where briefs from the contact form and the Project Builder go (pick one):
FORM_ENDPOINT=
CONTACT_EMAIL=
CONTACT_TELEGRAM=

# Accounts ("My account"). Create a free Supabase project, run supabase/schema.sql in its SQL editor and paste
# Project URL + anon public key here (setup/ACCOUNTS-SETUP.md). Empty = demo accounts stored in the visitor's browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
